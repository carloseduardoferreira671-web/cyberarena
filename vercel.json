{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo sem-dependencias",
  "buildCommand": "echo sem-build",
  "outputDirectory": ".",
  "cleanUrls": false,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?route=:path*" }
  ],
  "functions": {
    "api/index.mjs": { "maxDuration": 15 }
  },
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/(.*)\\.(js|mjs|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/(.*)\\.(png|webp|jpg|bin|wav|mp3|glb)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/CyberArena.apk", "headers": [{ "key": "Content-Type", "value": "application/vnd.android.package-archive" }, { "key": "Content-Disposition", "value": "attachment; filename=CyberArena.apk" }] }
  ]
}
